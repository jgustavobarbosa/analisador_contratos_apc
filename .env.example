# Copy to .env at repo root and/or apps/api/.env

# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://rayia:rayia@localhost:5432/rayia_identity?schema=public

# Nest API
API_PORT=3000
NODE_ENV=development

# Session cookie
SESSION_COOKIE_NAME=rayia_session
SESSION_TTL_HOURS=12
# Required in production — random 32+ bytes
SESSION_SECRET=change-me-to-a-long-random-secret

# Cookie flags (Secure must be true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
# Base URL for reset links in e-mails (PoC may log to console)
APP_PUBLIC_URL=http://localhost:5180

# Auth lockout (login failures)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limit (in-memory PoC — replace with reverse-proxy/Redis in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20

# Seed (dev only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin1!

# Frontend (Vercel) — URL pública da API Nest (sem barra final)
# VITE_API_BASE_URL=https://api.seu-dominio.com

# API — origens permitidas no browser (vírgula). Ex.: https://seu-app.vercel.app
# CORS_ORIGINS=https://seu-app.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# OmniRoute LLM
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=kc/deepseek/deepseek-v4-flash
