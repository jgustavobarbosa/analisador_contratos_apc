{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "incremental": false,
    "isolatedModules": true,
    "preserveSymlinks": true,
    "rootDirs": ["src", "../../src"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "prisma/**/*",
    "fixtures/**/*",
    "../../src/simulation/**/*",
    "../../src/ml/**/*",
    "../../src/core/**/*"
  ]
}
